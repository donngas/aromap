# Copy to .env at the repository root. Defaults also work without a .env file.
# Credentials are only required for optional LLM recognition.

# Local Compose resource namespace. Use -p aromap-staging for staging isolation.
COMPOSE_PROJECT_NAME=aromap-local

# Host-facing ports; container ports are fixed by each build target.
# Use 0.0.0.0 intentionally when access from other machines is needed.
HOST_BIND=127.0.0.1
FRONTEND_PORT=5173
BACKEND_PORT=8000

# Vite/Nginx proxy target inside Docker; independent of BACKEND_PORT.
# Use an origin (scheme + host + port), without a path or trailing slash.
API_PROXY_TARGET=http://backend:8000
# Nginx staging request-body limit; allow multipart overhead above the backend limit.
# Increase this too when raising AROMAP_MAX_UPLOAD_BYTES. Vite has no matching cap.
FRONTEND_MAX_BODY_SIZE=12m

# CORS is for direct cross-origin requests; same-origin /api proxying needs none.
# Blank: Compose allows localhost and 127.0.0.1 at FRONTEND_PORT automatically.
# For other browser origins, supply a comma-separated list of complete origins.
AROMAP_CORS_ORIGINS=

# Temporary upload/job storage settings. Container data directory stays /data.
AROMAP_MAX_UPLOAD_BYTES=10485760
AROMAP_MAX_IMAGE_PIXELS=20000000
AROMAP_RETENTION_SECONDS=86400
AROMAP_CLEANUP_INTERVAL_SECONDS=60
AROMAP_QUEUE_CAPACITY=4
AROMAP_SIMULATION_MAX_WORKING_BYTES=536870912

# Blank uses the built-in OpenCV provider. Override only for another provider.
AROMAP_RECOGNITION_CALLABLE=
AROMAP_RECOGNITION_TIMEOUT_SECONDS=60

# Optional experimental recognition (request use_llm=true). Backend only.
OPENAI_API_KEY=
